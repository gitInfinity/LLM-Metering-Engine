# Local development only. Keep DATABASE_URL aligned with POSTGRES_* below.
POSTGRES_DB=capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql+psycopg://capstone:local_dev_password@localhost:5432/capstone

# Required for /generate. Set approved rates; no default charges are assumed.
INPUT_RATE_PER_MILLION=
CACHED_RATE_PER_MILLION=
OUTPUT_RATE_PER_MILLION=
API_CALL_RATE=
BILLING_CURRENCY=
PRICING_VERSION=

# Phase 3 Stripe sandbox/test setup (Checkout and signed subscription webhooks).
# Pro: USD 20.00 per month, recurring flat rate; use resources from the same sandbox.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
# Set when configuring the webhook endpoint or local Stripe CLI listener.
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:8000/docs
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:8000/docs
